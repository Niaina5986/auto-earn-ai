name: OPTIMUS V3 - Publish report

on:
  workflow_run:
    types: [completed]

permissions:
  actions: read
  contents: write

jobs:
  publish-report:
    if: >
      github.event.workflow_run.path == '.github/workflows/optimus-v3.yml' &&
      github.event.workflow_run.conclusion == 'success'

    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          ref: main
          token: ${{ secrets.GITHUB_TOKEN }}

      - name: Download OPTIMUS V3 artifact
        uses: actions/download-artifact@v4
        with:
          name: optimus-v3-reports
          run-id: ${{ github.event.workflow_run.id }}
          github-token: ${{ secrets.GITHUB_TOKEN }}
          repository: ${{ github.repository }}
          path: ./optimus-v3-download

      - name: Publish latest.json
        shell: bash
        run: |
          set -euo pipefail

          REPORT="$(find ./optimus-v3-download -type f -name 'latest.json' -print -quit)"

          if [ -z "$REPORT" ]; then
            echo "ERREUR : latest.json introuvable dans l'artifact."
            find ./optimus-v3-download -maxdepth 5 -type f -print
            exit 1
          fi

          mkdir -p ./optimus-v3-reports
          cp "$REPORT" ./optimus-v3-reports/latest.json

          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git add ./optimus-v3-reports/latest.json

          if git diff --cached --quiet; then
            echo "Le rapport est déjà à jour."
          else
            git commit -m "Publish OPTIMUS V3 latest report"
            git push origin HEAD:main
          fi